<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: lets NoteMesh ask Notes to show the note you click (AppleScript).
	     macOS still asks you first (Privacy & Security → Automation). Nothing else is needed:
	     no network, no camera, no JIT. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
